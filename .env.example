# Path to the SQLite database file
DB_PATH=C:\astro\astrophoto\astro.db

# Path to the stacks directory (default used by `import stacks`)
STACKS_DIR=C:\astro\astrophoto\stacks

# Path to the astro-photo-renamer output directory (default used by `import renamer`)
RENAMER_OUTPUT_DIR=C:\astro\astrophoto\tools\astro-photo-renamer\output

# Session grouping: maximum gap (minutes) between frames in the same session
SESSION_GAP_MINUTES=30
